<% page_title "Cookies" %>

<article class="wrap measure">
  <h1 class="text-4xl">Cookies</h1>

  <p class="mt-6 text-ink-600">
    This application sets only the cookies it needs. There is no analytics cookie, no
    advertising cookie, and no session recording.
  </p>

  <dl class="mt-8 space-y-5 text-ink-600">
    <div>
      <dt class="font-display text-lg text-ink-950">Session</dt>
      <dd class="mt-1 text-sm">Keeps you signed in. Essential; cannot be turned off while signed in.</dd>
    </div>
    <div>
      <dt class="font-display text-lg text-ink-950">Consent</dt>
      <dd class="mt-1 text-sm">Remembers your cookie choice and your consent record token. Essential.</dd>
    </div>
    <div>
      <dt class="font-display text-lg text-ink-950">Security</dt>
      <dd class="mt-1 text-sm">Protects forms against cross-site request forgery. Essential.</dd>
    </div>
  </dl>

  <% if user_signed_in? %>
    <p class="meta mt-8">
      <%= link_to "Manage your consents", account_consent_path, class: "underline" %>
    </p>
  <% end %>
</article>
