<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "AI Pop Music" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Licensed AI-generated songs for creators. Subscribe to a genre and download cleared tracks for your videos, podcasts and games." %>">
    <meta name="theme-color" content="#050507">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="AI Pop Music">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# The design direction is applied before first paint, so a returning
        visitor never sees a flash of a different one. Inline and tiny on
        purpose; everything else about the switcher lives in theme_controller.js. %>
    <script>
      (function () {
        try {
          var stored = window.localStorage.getItem("apm:theme");
          document.documentElement.setAttribute("data-theme", stored || "signal");
        } catch (error) {
          document.documentElement.setAttribute("data-theme", "signal");
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col" data-controller="player">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-accent focus:text-accent-ink focus:px-3 focus:py-2">
      Skip to content
    </a>

    <%# The listening room's lighting. Painted by the player from the real
        analyser, so the page breathes with whatever is playing. %>
    <canvas data-player-target="ambient"
            aria-hidden="true"
            class="pointer-events-none fixed inset-0 -z-10 h-full w-full opacity-70"></canvas>

    <header class="sticky top-0 z-30 border-b border-ink-800 bg-ink-1000/85 backdrop-blur-md">
      <div class="wrap flex items-center justify-between gap-6 py-4">
        <%= link_to root_path, class: "flex items-baseline gap-2 group" do %>
          <span class="font-display text-xl font-semibold tracking-tight">AI Pop Music</span>
          <span class="meta hidden sm:inline transition-colors group-hover:text-accent">licensed catalogue</span>
        <% end %>

        <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
          <%= nav_link "Genres", genres_path %>
          <%= nav_link "Plans", plans_path %>
          <%= nav_link "Search", search_path %>
          <% if user_signed_in? %>
            <%= nav_link "Account", account_root_path %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-ghost text-sm" %>
          <% else %>
            <%= nav_link "Sign in", new_user_session_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <div aria-live="polite" class="wrap">
      <% if notice.present? %>
        <p class="mt-4 border border-ok/40 bg-ink-900 px-4 py-3 text-sm text-ok" role="status"><%= notice %></p>
      <% end %>

      <% if alert.present? %>
        <p class="mt-4 border border-danger/40 bg-ink-900 px-4 py-3 text-sm text-danger" role="alert"><%= alert %></p>
      <% end %>
    </div>

    <main id="main" class="flex-1 pb-40">
      <%= yield %>
    </main>

    <footer class="border-t border-ink-800">
      <div class="wrap grid gap-10 py-12 sm:grid-cols-3">
        <div>
          <p class="font-display text-lg">AI Pop Music</p>
          <p class="measure mt-2 text-sm text-paper-dim">
            Licensed AI-generated songs for creators. Every download records the licence
            version it was granted under.
          </p>
        </div>

        <nav aria-label="Catalogue" class="text-sm">
          <p class="meta">Catalogue</p>
          <ul class="mt-3 space-y-2">
            <li><%= link_to "Genres", genres_path, class: "hover:text-accent" %></li>
            <li><%= link_to "Plans", plans_path, class: "hover:text-accent" %></li>
            <li><%= link_to "Blog", blog_path, class: "hover:text-accent" %></li>
          </ul>
        </nav>

        <nav aria-label="Legal" class="text-sm">
          <p class="meta">Legal</p>
          <ul class="mt-3 space-y-2">
            <li><%= link_to "License", page_license_path, class: "hover:text-accent" %></li>
            <li><%= link_to "Terms", page_terms_path, class: "hover:text-accent" %></li>
            <li><%= link_to "Privacy", page_privacy_path, class: "hover:text-accent" %></li>
          </ul>
        </nav>
      </div>

      <div class="wrap pb-12">
        <p class="meta">
          Songs generated with YuE2. Metadata is recorded from the run that produced each track.
        </p>
      </div>
    </footer>

    <%# The player bar. It is ordinary markup - Turbo replaces it on every
        navigation, which is fine: the player controller re-renders it from the
        audio element's state. The audio element itself is NOT here; it is
        created by the controller and attached to <html>, outside Turbo's swap,
        so playback survives navigation without Stimulus and Turbo fighting over
        the same element. %>
    <div id="player-root" class="pointer-events-none fixed inset-x-0 bottom-0 z-40">
      <div data-player-target="bar"
           data-state="idle"
           class="pointer-events-auto translate-y-full border-t border-ink-700 bg-ink-950/95 backdrop-blur-md transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)]"
           style="transition-timing-function: var(--ease-out-expo)">
        <div class="wrap flex items-center gap-4 py-3 sm:gap-6">
          <button type="button"
                  data-player-target="playButton"
                  data-action="player#toggle"
                  class="play shrink-0"
                  aria-pressed="false"
                  aria-label="Play"
                  disabled>
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" fill="currentColor">
              <path d="M8 5.5v13l11-6.5-11-6.5Z" class="player-icon-play" />
              <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" class="player-icon-pause hidden" />
            </svg>
          </button>

          <img data-player-target="artwork" alt="" class="hidden h-12 w-12 shrink-0 rounded-[3px] object-cover" width="48" height="48">

          <div class="min-w-0 flex-1">
            <p data-player-target="title" class="truncate font-display text-base leading-tight"></p>
            <p data-player-target="subtitle" class="meta truncate"></p>
          </div>

          <%# The one place the analyser paints at full strength. %>
          <canvas data-player-target="trace"
                  aria-hidden="true"
                  class="hidden h-10 w-40 shrink-0 sm:block"
                  data-trace></canvas>

          <div class="hidden flex-1 items-center gap-3 sm:flex">
            <span data-player-target="elapsed" class="meta-plain w-10 shrink-0 text-right">0:00</span>

            <div data-player-target="seek"
                 role="slider"
                 tabindex="0"
                 aria-label="Seek"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="0"
                 data-action="click->player#scrub keydown->player#nudge"
                 class="group relative h-8 flex-1 cursor-pointer">
              <span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-ink-600"></span>
              <span data-player-target="seekFill"
                    class="absolute inset-x-0 top-1/2 h-px origin-left -translate-y-1/2 bg-accent"
                    style="transform: scaleX(0)"></span>
            </div>
          </div>

          <form data-player-target="download" method="post" action="#" class="hidden shrink-0">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <button type="submit" class="btn btn-ghost text-sm">Download</button>
          </form>
        </div>
      </div>
    </div>

    <%# The direction switcher. Three complete design worlds share one codebase,
        so a choice made here restyles every page instantly. %>
    <div data-controller="theme" class="fixed bottom-4 left-4 z-50 print:hidden">
      <div class="surface flex items-center gap-1 p-1" role="group" aria-label="Design direction">
        <% [ [ "label", "Label" ], [ "signal", "Signal" ], [ "gallery", "Gallery" ] ].each do |key, name| %>
          <button type="button"
                  data-theme="<%= key %>"
                  data-action="theme#select"
                  data-theme-target="option"
                  aria-pressed="false"
                  class="px-3 py-1.5 text-xs font-medium uppercase tracking-wider transition-colors hover:text-accent aria-pressed:bg-accent aria-pressed:text-accent-ink">
            <%= name %>
          </button>
        <% end %>
      </div>
      <p data-theme-target="live" aria-live="polite" class="sr-only"></p>
    </div>
  </body>
</html>
