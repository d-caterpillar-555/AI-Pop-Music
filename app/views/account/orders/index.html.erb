<% page_title "Orders" %>

<section class="wrap">
  <p class="meta uppercase"><%= link_to "Account", account_root_path, class: "underline" %></p>
  <h1 class="mt-3 text-3xl">Orders</h1>

  <% if @orders.any? %>
    <ul class="mt-8 divide-y divide-ink-700 border-y border-ink-700">
      <% @orders.each do |order| %>
        <li class="flex flex-wrap items-center justify-between gap-4 py-4">
          <div>
            <p class="font-display text-lg">
              <%= link_to order.number, account_order_path(order.number), class: "hover:underline" %>
            </p>
            <p class="meta mt-1">
              <%= order.plan.name %> · <%= formatted_price(order.amount_cents, order.currency) %>
              · <%= order.placed_at.strftime("%-d %b %Y") %>
            </p>
          </div>
          <%= status_chip order.status, tone: (order.paid? ? :ok : :warn) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-8 text-ink-600">No orders yet.</p>
  <% end %>
</section>
