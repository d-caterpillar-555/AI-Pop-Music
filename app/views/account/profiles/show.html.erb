<% page_title "Profile" %>

<section class="wrap measure">
  <p class="meta uppercase"><%= link_to "Account", account_root_path, class: "underline" %></p>
  <h1 class="mt-3 text-3xl">Your profile</h1>

  <dl class="mt-8 space-y-4 border-y border-paper-100 py-6 text-sm">
    <div class="flex justify-between gap-4">
      <dt class="text-ink-600">Name</dt>
      <dd><%= member.name %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-ink-600">Email</dt>
      <dd><%= member.email %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-ink-600">Member since</dt>
      <dd><%= member.created_at.strftime("%-d %b %Y") %></dd>
    </div>
  </dl>

  <div class="mt-6 flex flex-wrap gap-3">
    <%= link_to "Edit details", edit_account_profile_path, class: "btn btn-secondary" %>
    <%= link_to "Change password", new_user_password_path, class: "btn btn-ghost" %>
  </div>
</section>
