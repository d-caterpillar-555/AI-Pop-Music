<% page_title "Edit profile" %>

<section class="wrap measure">
  <p class="meta uppercase"><%= link_to "Profile", account_profile_path, class: "underline" %></p>
  <h1 class="mt-3 text-3xl">Edit your details</h1>

  <%= form_with model: member, url: account_profile_path, method: :patch, class: "mt-8 space-y-5" do |form| %>
    <% if member.errors.any? %>
      <div class="card border-danger/40 p-4" role="alert">
        <p class="font-medium text-danger">Your details were not saved:</p>
        <ul class="mt-2 list-inside list-disc text-sm text-ink-600">
          <% member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, class: "input", required: true, autocomplete: "name" %>
    </div>

    <div>
      <%= form.label :email, class: "label" %>
      <%= form.email_field :email, class: "input", required: true, autocomplete: "email" %>
      <p class="meta mt-1">Used for sign-in and licence confirmations.</p>
    </div>

    <%= form.submit "Save", class: "btn btn-primary" %>
  <% end %>
</section>
