<% page_title "Your consents" %>

<section class="wrap measure">
  <p class="meta uppercase"><%= link_to "Account", account_root_path, class: "underline" %></p>
  <h1 class="mt-3 text-3xl">Consents</h1>
  <p class="mt-3 text-ink-600">
    What you have agreed to, and when. Records are append-only: a withdrawal adds a record
    rather than editing the old one.
  </p>

  <ul class="mt-8 divide-y divide-ink-700 border-y border-ink-700">
    <% ConsentRecord::KINDS.each do |kind| %>
      <li class="flex flex-wrap items-center justify-between gap-4 py-4">
        <div>
          <p class="font-display text-lg"><%= kind.titleize %></p>
          <p class="meta mt-1">
            <%= @current[kind] ? "Granted" : "Not granted" %>
          </p>
        </div>

        <%= button_to (@current[kind] ? "Withdraw" : "Grant"),
          account_consent_path(kind: kind, granted: !@current[kind]),
          method: :patch,
          class: "btn #{@current[kind] ? "btn-ghost" : "btn-secondary"} text-sm" %>
      </li>
    <% end %>
  </ul>

  <% if @consents.any? %>
    <h2 class="mt-10 text-xl">History</h2>
    <ul class="mt-4 space-y-2 text-sm text-ink-600">
      <% @consents.each do |record| %>
        <li>
          <span class="meta"><%= record.granted_at.strftime("%-d %b %Y") %></span>
          <%= record.kind.titleize %>
          <%= record.revoked? ? "withdrawn" : "granted" %>
          <span class="meta">(terms <%= record.policy_version %>)</span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
