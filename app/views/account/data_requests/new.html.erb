<% page_title "New data request" %>

<section class="wrap measure">
  <p class="meta uppercase"><%= link_to "Your data", account_data_requests_path, class: "underline" %></p>
  <h1 class="mt-3 text-3xl">New request</h1>

  <%= form_with model: @data_request, url: account_data_requests_path, class: "mt-8 space-y-5" do |form| %>
    <% if @data_request.errors.any? %>
      <div class="card border-danger/40 p-4" role="alert">
        <ul class="list-inside list-disc text-sm text-ink-600">
          <% @data_request.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset>
      <legend class="label">What do you need?</legend>
      <div class="mt-2 space-y-3">
        <label class="flex items-start gap-3">
          <%= form.radio_button :kind, "export", class: "mt-1" %>
          <span>
            <span class="font-medium">Export my data</span>
            <span class="block text-sm text-ink-600">A copy of your profile, orders and downloads.</span>
          </span>
        </label>
        <label class="flex items-start gap-3">
          <%= form.radio_button :kind, "deletion", class: "mt-1" %>
          <span>
            <span class="font-medium">Delete my personal details</span>
            <span class="block text-sm text-ink-600">Orders and download records are kept as licence evidence.</span>
          </span>
        </label>
      </div>
    </fieldset>

    <%= form.submit "Submit request", class: "btn btn-primary" %>
  <% end %>
</section>
