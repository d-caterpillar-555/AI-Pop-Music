<% page_title "#{@genre.name} tracks" %>
<% page_description(@genre.description.presence || "Licensed #{@genre.name} tracks for creators. Preview free, download full 48 kHz masters with a subscription.") %>

<section class="wrap">
  <p class="meta uppercase"><%= link_to "Genres", genres_path, class: "underline" %></p>

  <div class="mt-4 grid gap-8 lg:grid-cols-[2fr_1fr] lg:items-start">
    <div>
      <h1 class="text-4xl"><%= @genre.name %></h1>
      <% if @genre.description.present? %>
        <p class="measure mt-4 text-lg text-ink-600"><%= @genre.description %></p>
      <% end %>
      <p class="meta mt-4">
        <%= pluralize(@tracks.size, "published track") %> · preview any of them without an account
      </p>
    </div>

    <aside class="card p-6">
      <p class="font-display text-xl">Unlock this genre</p>
      <p class="mt-2 text-sm text-ink-600">
        A plan covers this genre plus the others you pick, with unlimited downloads of the
        full-length masters inside them.
      </p>
      <ul class="mt-4 space-y-2 text-sm text-ink-600">
        <li>48 kHz stereo FLAC, full length</li>
        <li>Commercial licence, recorded per download</li>
        <li>Cancel any time; published work stays licensed</li>
      </ul>
      <%= link_to "Choose a plan", plans_path, class: "btn btn-primary mt-5 w-full" %>
      <p class="meta mt-3">From $5 a month.</p>
    </aside>
  </div>

  <% if @tracks.any? %>
    <ul class="mt-12 divide-y divide-paper-100 border-y border-paper-100">
      <% @tracks.each do |track| %>
        <%= render "tracks/track_row", track: track,
          entitled: (current_member ? current_member.can_download?(track) : false) %>
      <% end %>
    </ul>

    <div class="card mt-10 flex flex-wrap items-center justify-between gap-6 p-6">
      <p class="text-sm text-ink-600">
        Heard something that fits? Subscribing to <%= @genre.name %> takes a minute.
      </p>
      <%= link_to "Subscribe to download", plans_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <p class="mt-12 text-ink-600">
      No tracks in this genre yet. An editor publishes them as they are rendered and checked.
    </p>
  <% end %>
</section>
