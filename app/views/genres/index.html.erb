<% page_title "Genres" %>
<% page_description "Browse every genre in the AI Pop Music catalogue." %>

<section class="wrap">
  <h1 class="text-3xl">Genres</h1>
  <p class="measure mt-3 text-ink-600">
    Each genre is a catalogue you subscribe to. Preview anything; download the ones you
    are entitled to.
  </p>

  <% if @genres.any? %>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      <% @genres.each do |genre| %>
        <li class="card p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <%= link_to genre_path(genre), class: "font-display text-2xl hover:underline" do %>
                <%= genre.name %>
              <% end %>
              <p class="meta mt-2"><%= pluralize(genre.track_count, "track") %></p>
            </div>
            <% if genre.artwork.attached? %>
              <%= image_tag genre.artwork.variant(resize_to_fill: [ 96, 96 ]),
                alt: "", class: "h-16 w-16 rounded-control object-cover", loading: "lazy" %>
            <% end %>
          </div>

          <% if genre.description.present? %>
            <p class="mt-4 text-sm text-ink-600"><%= genre.description %></p>
          <% end %>

          <div class="mt-5 flex items-center gap-3">
            <%= link_to "Open genre", genre_path(genre), class: "btn btn-secondary text-sm" %>
            <%= link_to "Subscribe", plans_path, class: "btn btn-ghost text-sm" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-10 text-ink-600">
      No genres are published yet. <%= link_to "See the plans", plans_path, class: "underline" %> to be ready when they land.
    </p>
  <% end %>
</section>
