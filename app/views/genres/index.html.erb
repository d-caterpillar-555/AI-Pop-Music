<% page_title "Genres" %>
<% page_description "Browse every genre in the AI Pop Music catalogue. Preview free, subscribe to download full-length masters." %>

<section class="wrap pt-10" data-controller="reveal">
  <p class="meta" data-reveal>Catalogue</p>
  <h1 class="display-1 mt-4 max-w-[16ch]" data-reveal style="--reveal-delay: 60ms">Pick the sound of your work.</h1>
  <p class="lede mt-6" data-reveal style="--reveal-delay: 120ms">
    Each genre is a catalogue you subscribe to. Preview anything without an account; the
    masters unlock when your plan covers the genre.
  </p>

  <% if @genres.any? %>
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @genres.each_with_index do |genre, index| %>
        <li data-reveal style="--reveal-delay: <%= (index % 3) * 70 %>ms">
          <%= link_to genre_path(genre), class: "surface surface-hover group flex h-full flex-col p-6" do %>
            <div class="flex items-start justify-between gap-4">
              <p class="font-display text-3xl"><%= genre.name %></p>
              <span class="meta-plain shrink-0"><%= pluralize(genre.track_count, "track") %></span>
            </div>

            <% if genre.description.present? %>
              <p class="mt-4 text-sm text-paper-dim"><%= genre.description %></p>
            <% end %>

            <span class="meta mt-auto pt-8 text-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              Open genre →
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="surface mt-14 p-6 text-paper-dim">
      No genres are published yet. <%= link_to "See the plans", plans_path, class: "text-accent" %>
      to be ready when tracks land.
    </p>
  <% end %>
</section>
