<% page_title @plan.name %>

<section class="wrap measure">
  <p class="meta uppercase"><%= link_to "Plans", plans_path, class: "underline" %></p>
  <h1 class="mt-4 text-3xl"><%= @plan.name %></h1>
  <p class="mt-3 text-2xl">
    <span class="font-display text-4xl"><%= formatted_price(@plan.price_cents, @plan.currency) %></span>
    <span class="meta"><%= @plan.billed_as %></span>
  </p>

  <p class="mt-6 text-ink-600">
    Covers <%= pluralize(@plan.genre_limit, "genre") %>, with unlimited downloads inside them.
    You choose which genres after the subscription is active.
  </p>

  <%= link_to "Start this plan", subscribe_path(plan_slug: @plan.slug), class: "btn btn-primary mt-8" %>
</section>
