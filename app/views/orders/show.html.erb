<% page_title "Order #{@order.number}" %>

<section class="wrap measure">
  <p class="meta uppercase">Order</p>
  <h1 class="mt-3 text-3xl"><%= @order.number %></h1>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <%= status_chip @order.status, tone: (@order.paid? ? :ok : :warn) %>
    <span class="meta">Placed <%= @order.placed_at.strftime("%-d %b %Y, %H:%M UTC") %></span>
  </div>

  <dl class="mt-8 space-y-3 border-y border-ink-700 py-5 text-sm">
    <div class="flex justify-between gap-4">
      <dt class="text-ink-600">Plan</dt>
      <dd><%= @order.plan.name %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-ink-600">Billing</dt>
      <dd><%= @order.plan.billed_as %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-ink-600">Genres included</dt>
      <dd><%= @order.plan.genre_limit %></dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="text-ink-600">Amount</dt>
      <dd><%= formatted_price(@order.amount_cents, @order.currency) %></dd>
    </div>
  </dl>

  <% if @order.paid? %>
    <p class="mt-6 text-ink-600">
      Paid<%= " on #{@order.paid_at.strftime('%-d %b %Y')}" if @order.paid_at %>.
      Your subscription is active.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to "Choose your genres", subscription_path, class: "btn btn-primary" %>
      <%= link_to "Browse genres", genres_path, class: "btn btn-secondary" %>
    </div>
  <% else %>
    <div class="card mt-6 p-5">
      <p class="font-display text-lg">Waiting on payment</p>
      <p class="mt-2 text-sm text-ink-600">
        No payment provider is connected yet, so an admin settles this order with you directly.
        Reply to the confirmation email with the order number above and we will take it from there.
        The subscription activates the moment the payment is recorded.
      </p>
    </div>
    <p class="meta mt-4">
      Keep this link: it is the only way to reach this order, and it is not guessable.
    </p>
  <% end %>

  <% if user_signed_in? && @order.user_id == current_user.id %>
    <p class="meta mt-6"><%= link_to "All your orders", account_orders_path, class: "underline" %></p>
  <% end %>
</section>
