<% page_title "Lab" %>
<% page_description "Three motion pieces built from code: an exploded guitar, a band room you can play, and a track drawn from its own waveform." %>

<section class="wrap py-10">
  <p class="meta">Workshop</p>
  <h1 class="display-2 mt-4">Motion studies</h1>
  <p class="lede mt-5">
    Three pieces built from code rather than assets, so they ship with the
    application and restyle with everything else.
  </p>
</section>

<%# (a) The exploded guitar. %>
<section class="wrap mt-6" data-controller="exploded-guitar reveal"
         data-exploded-guitar-url-value="/models/exploded_guitar.glb">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="meta">01</p>
      <h2 class="display-2 mt-2">The guitar, apart</h2>
      <p class="lede mt-3 text-base">
        Every component on its own travel axis. Drag to take it apart and see what
        actually sits under the guard - strings, poles, cavity cover, and the
        hardware that holds it together.
      </p>
    </div>
    <p class="meta" data-exploded-guitar-target="readout">Assembled</p>
  </div>

  <div class="surface mt-8 overflow-hidden">
    <canvas data-exploded-guitar-target="canvas"
            class="block h-[520px] w-full touch-none"
            role="img"
            aria-label="An electric guitar in three dimensions. Use the control below to separate its components."></canvas>

    <div class="flex flex-wrap items-center gap-4 border-t border-ink-700 px-5 py-4">
      <label for="explode" class="label mb-0 whitespace-nowrap">Take it apart</label>
      <input id="explode"
             type="range"
             min="0"
             max="100"
             value="28"
             step="1"
             data-exploded-guitar-target="slider"
             data-action="input->exploded_guitar#explode"
             class="h-6 flex-1 min-w-48 accent-[var(--color-accent)]">
      <span class="meta">drag to orbit</span>
    </div>
  </div>
</section>

<%# (b) The room. Nine instruments, all of them playable - the geometry comes
    from Blender, the sound from oscillators in the page. %>
<section class="wrap mt-16" data-controller="band-room"
         data-band-room-url-value="/models/band_room.glb">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="meta">02</p>
      <h2 class="display-2 mt-2">The room</h2>
      <p class="lede mt-3 text-base">
        A band's rehearsal room, modelled in Blender and exported as one model.
        Click any instrument to play it, or let the room play itself.
      </p>
    </div>
    <p class="meta" data-band-room-target="readout">Nine instruments. Click one.</p>
  </div>

  <div class="surface mt-8 overflow-hidden">
    <canvas data-band-room-target="canvas"
            class="block h-[560px] w-full touch-none"
            role="img"
            aria-label="A rehearsal room in three dimensions with nine playable instruments. Drag to turn the room; click an instrument to hear it."></canvas>

    <div class="flex flex-wrap items-center gap-3 border-t border-ink-700 px-5 py-4">
      <button type="button"
              class="btn btn-primary"
              data-band-room-target="groove"
              data-action="click->band_room#groove"
              aria-pressed="false">The room plays</button>

      <p class="meta ml-auto" data-band-room-target="status">Loading the room…</p>
    </div>

    <div class="flex flex-wrap gap-2 border-t border-ink-700 px-5 py-4">
      <% { "Drums" => "Drums", "Elec1" => "Electric I", "Elec2" => "Electric II",
           "Bass" => "Bass", "Acoustic" => "Acoustic", "Keys" => "Keys",
           "Amp" => "Amp stack", "Mic" => "Vocal mic", "Board" => "Pedalboard" }.each do |node, label| %>
        <button type="button"
                class="chip"
                data-action="click->band_room#instrument"
                data-band-room-name-param="<%= node %>"><%= label %></button>
      <% end %>
    </div>
  </div>
</section>

<%# (c) The song, drawn. The stored peaks are the whole track's shape; the live
    analyser drives the front rank only. %>
<section class="wrap mt-16"
         data-controller="visualiser"
         data-visualiser-peaks-value="<%= @tracks.first.peaks.to_json %>"
         data-visualiser-url-value="<%= track_preview_path(@tracks.first) %>"
         data-visualiser-seed-value="<%= @tracks.first.seed || 1 %>"
         data-visualiser-title-value="<%= @tracks.first.title %>"
         data-visualiser-tracks-value="<%= @tracks.map { |track| { title: track.title, url: track_preview_path(track), seed: track.seed || 1, peaks: track.peaks } }.to_json %>">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="meta">03</p>
      <h2 class="display-2 mt-2">The song, drawn</h2>
      <p class="lede mt-3 text-base">
        Each track's waveform is measured once when it is published and stored as
        five hundred numbers. The landscape behind is the whole song; the rank in
        front is the moment you are hearing.
      </p>
    </div>
    <p class="meta" data-visualiser-target="readout"></p>
  </div>

  <div class="surface mt-8 overflow-hidden">
    <canvas data-visualiser-target="canvas"
            class="block h-[520px] w-full touch-none"
            role="img"
            aria-label="A three-dimensional landscape drawn from the track's own waveform, with a live rank in front."></canvas>

    <div class="flex flex-wrap items-center gap-4 border-t border-ink-700 px-5 py-4">
      <button type="button"
              class="btn btn-primary"
              data-visualiser-target="play"
              data-action="click->visualiser#toggle"
              aria-pressed="false">Play the shape</button>

      <label for="scrub" class="label mb-0 whitespace-nowrap">Scrub</label>
      <input id="scrub"
             type="range"
             min="0"
             max="1000"
             value="0"
             step="1"
             data-visualiser-target="scrub"
             data-action="input->visualiser#scrub"
             class="h-6 flex-1 min-w-48 accent-[var(--color-accent)]">
      <span class="meta">drag to turn</span>
    </div>

    <div class="flex flex-wrap gap-2 border-t border-ink-700 px-5 py-4">
      <% @tracks.each_with_index do |track, index| %>
        <button type="button"
                class="chip <%= "chip-accent" if index.zero? %>"
                data-visualiser-target="picker"
                data-action="click->visualiser#choose"
                data-visualiser-index-param="<%= index %>"
                aria-pressed="<%= index.zero? %>"><%= track.title %></button>
      <% end %>
    </div>
  </div>
</section>
