<% page_title "Sign in" %>
<% page_description "Sign in to your AI Pop Music account to manage your subscription and download licensed masters." %>

<%# Sign-in is a designed screen, not a form dropped on a page: it carries the
    same promise as the marketing site, because a returning customer arrives
    mid-task and should not land somewhere that looks unfinished. %>
<section class="wrap py-10">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-start">
    <div data-controller="reveal">
      <p class="meta" data-reveal>Your account</p>
      <h1 class="display-2 mt-4 max-w-[18ch]" data-reveal style="--reveal-delay: 60ms">
        Back to your catalogue.
      </h1>
      <p class="lede mt-5" data-reveal style="--reveal-delay: 100ms">
        Sign in to manage your genres, re-download anything you are licensed for, and keep
        the download record that proves it.
      </p>

      <ul class="mt-8 space-y-3 text-sm text-paper-dim" data-reveal style="--reveal-delay: 140ms">
        <li class="flex gap-3">
          <span class="text-accent" aria-hidden="true">—</span>
          <span>Your download history, with the licence version recorded against every file.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent" aria-hidden="true">—</span>
          <span>Swap genres any time without changing the price.</span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent" aria-hidden="true">—</span>
          <span>Export or delete your data whenever you want to.</span>
        </li>
      </ul>

      <p class="meta mt-10" data-reveal style="--reveal-delay: 180ms">
        No account yet?
        <%= link_to "Create one", new_user_registration_path, class: "text-accent underline" %>
        - it takes a minute.
      </p>
    </div>

    <div class="surface p-6 sm:p-8" data-controller="reveal" data-reveal>
      <h2 class="font-display text-xl">Sign in</h2>

      <% if flash[:alert].present? && resource.errors.empty? %>
        <p class="mt-4 border border-danger/40 px-3 py-2 text-sm text-danger" role="alert">
          <%= flash[:alert] %>
        </p>
      <% end %>

      <%= form_with model: resource, as: resource_name, url: user_session_path, class: "mt-6 space-y-5" do |form| %>
        <% if resource.errors.any? %>
          <div class="border border-danger/40 p-3" role="alert">
            <p class="text-sm font-medium text-danger">We could not sign you in:</p>
            <ul class="mt-2 list-inside list-disc text-sm text-paper-dim">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :email, class: "label" %>
          <%= form.email_field :email, class: "input", required: true, autofocus: true,
            autocomplete: "email", spellcheck: false %>
        </div>

        <div data-controller="password">
          <%= form.label :password, class: "label" %>
          <div class="relative">
            <%= form.password_field :password, class: "input pr-16", required: true,
              autocomplete: "current-password", data: { password_target: "input" } %>
            <button type="button"
                    data-action="password#toggle"
                    data-password-target="button"
                    aria-pressed="false"
                    class="absolute inset-y-0 right-0 px-3 text-xs font-medium uppercase tracking-wider text-ink-300 hover:text-accent">
              Show
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between gap-4">
          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-2 text-sm text-paper-dim">
              <%= form.check_box :remember_me %>
              <span>Keep me signed in</span>
            </label>
          <% end %>
          <%= link_to "Forgot password?", new_user_password_path, class: "text-sm text-paper-dim underline hover:text-accent" %>
        </div>

        <%= form.submit "Sign in", class: "btn btn-primary w-full" %>
      <% end %>

      <p class="meta mt-6 text-center">
        <%= link_to "Create an account", new_user_registration_path, class: "text-accent underline" %>
      </p>
    </div>
  </div>
</section>
