<% page_title "Sign in" %>

<section class="wrap measure">
  <h1 class="text-3xl">Sign in</h1>
  <p class="mt-3 text-ink-600">
    New here? <%= link_to "Create an account", new_user_registration_path, class: "underline" %> first.
  </p>

  <%= form_with model: resource, as: resource_name, url: user_session_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email, class: "label" %>
      <%= form.email_field :email, class: "input", required: true, autofocus: true, autocomplete: "email" %>
    </div>

    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, class: "input", required: true, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :remember_me %>
        <span>Keep me signed in</span>
      </label>
    <% end %>

    <%= form.submit "Sign in", class: "btn btn-primary" %>
  <% end %>

  <p class="mt-6 text-sm">
    <%= link_to "Forgot your password?", new_user_password_path, class: "underline" %>
  </p>
</section>
