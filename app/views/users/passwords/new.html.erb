<% page_title "Reset password" %>

<section class="wrap measure">
  <h1 class="text-3xl">Reset your password</h1>
  <p class="mt-3 text-ink-600">We will email you a link to choose a new one.</p>

  <%= form_with model: resource, as: resource_name, url: user_password_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email, class: "label" %>
      <%= form.email_field :email, class: "input", required: true, autofocus: true, autocomplete: "email" %>
    </div>

    <%= form.submit "Send reset link", class: "btn btn-primary" %>
  <% end %>
</section>
