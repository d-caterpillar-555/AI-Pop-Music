<% page_title "Create an account" %>

<section class="wrap measure">
  <h1 class="text-3xl">Create an account</h1>
  <p class="mt-3 text-ink-600">
    An account holds your subscription, your downloads, and the licence record for each file.
  </p>

  <%= form_with model: resource, as: resource_name, url: user_registration_path, class: "mt-8 space-y-5" do |form| %>
    <% if resource.errors.any? %>
      <div class="card border-danger/40 p-4" role="alert">
        <p class="font-medium text-danger">Your account was not created:</p>
        <ul class="mt-2 list-inside list-disc text-sm text-ink-600">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "label" %>
      <%= form.text_field :name, class: "input", required: true, autofocus: true, autocomplete: "name" %>
    </div>

    <div>
      <%= form.label :email, class: "label" %>
      <%= form.email_field :email, class: "input", required: true, autocomplete: "email" %>
    </div>

    <div>
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, class: "input", required: true, autocomplete: "new-password" %>
      <p class="meta mt-1">At least <%= Devise.password_length.min %> characters.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "label" %>
      <%= form.password_field :password_confirmation, class: "input", required: true, autocomplete: "new-password" %>
    </div>

    <label class="flex items-start gap-3 text-sm">
      <%= check_box_tag "user[terms_accepted]", "1", false, required: true, class: "mt-1" %>
      <span>
        I accept the <%= link_to "terms", page_terms_path, class: "underline" %> and the
        <%= link_to "privacy policy", page_privacy_path, class: "underline" %>.
      </span>
    </label>

    <%= form.submit "Create account", class: "btn btn-primary" %>
  <% end %>
</section>
